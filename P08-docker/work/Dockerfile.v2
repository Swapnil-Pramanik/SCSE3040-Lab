FROM python:3.12-slim

WORKDIR /app

# Libraries first, so this layer stays cached when the code changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Code and model go in last.
COPY app.py .
COPY model.joblib .

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
